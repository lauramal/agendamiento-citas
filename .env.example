# Copie este archivo como .env
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/citas
URL_PUBLICA=http://localhost:8000
SECRETO_ENLACES=cambie-este-secreto

# Reglas de negocio (configurables sin tocar código)
DURACION_CITA_MIN=30
HORAS_RECORDATORIO=24
MINUTOS_RESERVA_OFERTA=120
HORAS_MINIMAS_CANCELACION=2

# Correo: en local lo captura Mailpit (ver http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025

# Para que los correos lleguen de verdad a Gmail, reemplace el bloque anterior por:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USUARIO=su.correo@gmail.com
# SMTP_CLAVE=contraseña-de-aplicacion-de-16-letras
# SMTP_REMITENTE=su.correo@gmail.com
# CORREO_REDIRIGIR_A=su.correo@gmail.com   # demo: todos los correos llegan aquí

# Asistente Nora (opcional). Sin llave, todo lo demás funciona.
ANTHROPIC_API_KEY=
LLM_MODELO=anthropic:claude-haiku-4-5
